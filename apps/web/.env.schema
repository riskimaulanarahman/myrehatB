# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
NEXT_PUBLIC_SERVER_URL=

# OpenRouter credentials for the WAHA concierge webhook (/api/webhooks/waha).
# Optional so builds work without it; the webhook returns 503 until it is set.
# @optional
OPENROUTER_API_KEY=

# OpenRouter model id; the webhook falls back to google/gemini-2.5-flash when empty.
# @optional @public
OPENROUTER_MODEL=
